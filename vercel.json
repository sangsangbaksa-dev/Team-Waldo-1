{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck && npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    { "source": "/parry-gladiator", "destination": "/parry-gladiator/", "permanent": false },
    { "source": "/dead-ground", "destination": "/dead-ground/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/room-tone/(.*)\\\\.(glb|png|jpg|mp3|ogg|wav)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}